<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Calibrated Steve wrist D415 collision macro.

    The fixed-joint origin is T_ur5etool0_camera from handeye_result.json.
    The housing is an UNVERIFIED placeholder, not a conservative safety bound.
    Measure and enlarge/reposition it to enclose the camera AND bracket before
    hardware execution. No actual bracket dimensions were available here.
    This macro does not start or configure the RealSense driver.
  -->
  <xacro:macro name="findvp_steve_d415" params="parent:=ur5etool0 optical_frame:=d415_calib_color_optical_frame_handeye">
    <link name="${optical_frame}">
      <visual>
        <!-- Optical convention: +X right, +Y down, +Z forward. -->
        <origin xyz="0 0 -0.0175" rpy="0 0 0"/>
        <geometry><box size="0.110 0.035 0.035"/></geometry>
        <material name="findvp_d415_dark"><color rgba="0.10 0.10 0.11 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 -0.0175" rpy="0 0 0"/>
        <geometry><box size="0.110 0.035 0.035"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 -0.0175" rpy="0 0 0"/>
        <mass value="0.15"/>
        <inertia ixx="0.000031" ixy="0" ixz="0" iyy="0.000157" iyz="0" izz="0.000157"/>
      </inertial>
    </link>
    <joint name="findvp_steve_d415_handeye_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${optical_frame}"/>
      <origin
        xyz="0.034826821173538705 -0.003987870576912486 0.06553079550290158"
        rpy="0.01532675 0.00383024 3.07538020"/>
    </joint>
  </xacro:macro>
</robot>
